{
  "threshold": 10,
  "reporters": ["html", "console"],
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/.git/**",
    "**/.changeset/**",
    "**/CHANGELOG.md",
    "**/package-lock.json",
    "**/dev/log/**"
  ],
  "format": ["javascript", "markdown"],
  "absolute": true,
  "gitignore": true,
  "minTokens": 30,
  "minLines": 5,
  "maxLines": 1100
}
