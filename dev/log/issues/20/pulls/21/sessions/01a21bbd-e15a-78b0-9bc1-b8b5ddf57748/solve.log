[2026-11-27T06:59:29.025Z] [STDOUT] {"type":"item.completed","item":{"id":"item_116","type":"command_execution","command":"/bin/bash -lc 'cat scripts/version-and-commit.mjs; cat scripts/publish-to-npm.mjs; tail -35 /tmp/gh-load-issue-final-check.log; tail -12 /tmp/gh-load-issue-package.log; git status --short | tail -12'","aggregated_output":"#!/usr/bin/env node\n\nimport { execFileSync } from 'node:child_process';\nimport { appendFileSync, readFileSync } from 'node:fs';\nimport yargs from 'yargs';\nimport { hideBin } from 'yargs/helpers';\nimport { packAndSmokeTest } from './package-smoke-test.mjs';\nimport { pendingChangesets, validateChangeset } from './validate-changeset.mjs';\n\nconst { mode, bumpType, description } = yargs(hideBin(process.argv))\n  .option('mode', {\n    choices: ['changeset', 'instant', 'recover'],\n    demandOption: true,\n  })\n  .option('bump-type', {\n    choices: ['major', 'minor', 'patch'],\n    default: process.env.BUMP_TYPE || undefined,\n  })\n  .option('description', {\n    type: 'string',\n    default: process.env.DESCRIPTION || '',\n  })\n  .strict()\n  .parse();\nconst manifest = () => JSON.parse(readFileSync('package.json', 'utf8'));\nconst capture = (args) =>\n  execFileSync('git', args, { encoding: 'utf8' }).trim();\nconst run = (command, args) =>\n  execFileSync(command, args, { stdio: 'inherit' });\nconst git = (...args) => run('git', args);\n\nasync function prepareVersion(trigger, remote) {\n  if (remote !== trigger) {\n    const parent = capture(['rev-parse', 'origin/main^']);\n    const message = capture(['log', '-1', '--format=%B', 'origin/main']);\n    const version = JSON.parse(\n      capture(['show', 'origin/main:package.json'])\n    ).version;\n    if (\n      mode === 'recover' ||\n      parent !== trigger ||\n      message !== `${version}\\n\\nRelease-Trigger: ${trigger}` ||\n      version === manifest().version\n    ) {\n      throw new Error(\n        'main advanced after checks started. Run the workflow on the