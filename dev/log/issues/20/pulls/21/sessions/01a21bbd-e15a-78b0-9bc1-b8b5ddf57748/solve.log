t.mjs            | 192 ++++++++++\n tests/test-e2e.test.mjs                   | 593 +++++++++++++-----------------\n tests/test-library.test.mjs               | 143 ++++---\n tests/test-npm-release.test.mjs           |  38 +-\n 30 files changed, 2096 insertions(+), 1757 deletions(-)\n#!/usr/bin/env bun\n\nimport { execFileSync } from 'node:child_process';\nimport { readdirSync, readFileSync } from 'node:fs';\nimport { pathToFileURL } from 'node:url';\nimport changesets from '@changesets/parse';\n\nconst { default: parseChangeset = changesets } = changesets;\n\nexport function needsChangeset(paths) {\n  return paths.some(\n    (file) =>\n      /^(?:(?:package(?:-lock)?\\.json|bun\\.lock|gh-load-issue\\.mjs)$|\\.github\\/|scripts\\/)/.test(\n        file\n      ) && !file.endsWith('.md')\n  );\n}\n\nexport function validateChangeset(name, filename, contents) {\n  let parsed;\n  try {\n    parsed = parseChangeset(contents);\n  } catch {\n    throw new Error(\n      `${filename} must begin with valid Changesets frontmatter.`\n    );\n  }\n  if (\n    !/^---\\r?\\n/.test(contents) ||\n    parsed.releases.length !== 1 ||\n    parsed.releases[0].name !== name ||\n    !['major', 'minor', 'patch'].includes(parsed.releases[0].type) ||\n    !parsed.summary\n  ) {\n    throw new Error(\n      `${filename} must declare one major, minor, or patch bump for ${name} and include a description.`\n    );\n  }\n}\n\nexport function pendingChangesets() {\n  return readdirSync('.changeset', { withFileTypes: true })\n    .filter(\n      (entry) =>\n        entry.isFile() &&\n        entry.name.endsWith('.md') &&\n        entry.name !== 'README.md'\n    )\n    .map((entry) => `.changeset/${entry.name}`);\n}\n\nif (\n  process.argv[1] &&\n  pathToFileURL(process.argv[1]).href === import.meta.url\n) {\n  try {\n    const base = process.env.PR_BASE_SHA;\n    const git = (args) =>\n      execFileSync('git', args, { encoding: 'utf8' })\n        .split('\\0')\n        .filter(Boolean);\n    const changes = base\n      ? git(['diff', '--name-only', '-z', base, 'HEAD', '--'])\n      : [];\n    const present = pendingChangesets();\n    const candidates = base\n      ? present.filter((file) => changes.includes(file))\n      : present;\n\n    if (candidates.length === 0 && (!base || needsChangeset(changes))) {\n      throw new Error(\n        \"Add a changeset by running 'bun run changeset' and commit the result.\"\n      );\n    }\n\n    const { name } = JSON.parse(readFileSync('package.json', 'utf8'));\n    for (const file of candidates) {\n      validateChangeset(name, file, readFileSync(file, 'utf8'));\n      console.log(`Validated ${file}`);\n    }\n    if (candidates.length === 0) {\n      console.log(\n        'Changeset is optional for documentation, tests, and other non-release changes.'\n      );\n    }\n  } catch (error) {\n    console.error(error.message);\n    process.exitCode = 1;\n  }\n}\n#!/usr/bin/env node\n\nimport { execFileSync } from 'node:child_process';\nimport { pathToFileURL } from 'node:url';\n\nexport function assertTrustedPublishingRuntime(nodeVersion, npmVersion) {\n  const [nodeMajor, nodeMinor] = nodeVersion\n    .replace(/^v/, '')\n    .split('.')\n    .map(Number);\n  const [npmMajor, npmMinor, npmPatch] = npmVersion.split('.').map(Number);\n  const stableVersions = /^v?\\d+\\.\\d+\\.\\d+$/;\n  if (\n    !stableVersions.test(nodeVersion) ||\n    !(nodeMajor > 22 || (nodeMajor === 22 && nodeMinor >= 14)) ||\n    !stableVersions.test(npmVersion) ||\n    !(\n      npmMajor > 11 ||\n      (npmMajor === 11 && (npmMinor > 5 || (npmMinor === 5 && npmPatch >= 1)))\n    )\n  ) {\n    throw new Error(\n      `npm trusted publishing requires Node.js >=22.14.0 and npm >=11.5.1. Found Node.js ${nodeVersion} and npm ${npmVersion}. Update actions/setup-node before releasing.`\n    );\n  }\n}\n\nif (\n  process.argv[1] &&\n  pathToFileURL(process.argv[1]).href === import.meta.url\n) {\n  const npmVersion = execFileSync('npm', ['--version'], {\n    encoding: 'utf8',\n  }).trim();\n  assertTrustedPublishingRuntime(process.version, npmVersion);\n  console.log(\n    `Trusted publishing runtime: Node.js ${process.version}, npm ${npmVersion}`\n  );\n}\n#!/usr/bin/env node\n\nimport { readFileSync } from 'node:fs';\nimport { pathToFileURL } from 'node:url';\nimport { NPM_REGISTRY } from './package-smoke-test.mjs';\n\nexport async function checkTrustedPublisher(\n  name,\n  { env = process.env, request = fetch } = {}\n) {\n  const {\n    ACTIONS_ID_TOKEN_REQUEST_URL,\n    ACTIONS_ID_TOKEN_REQUEST_TOKEN,\n    GITHUB_REPOSITORY,\n  } = env;\n  if (!ACTIONS_ID_TOKEN_REQUEST_URL || !ACTIONS_ID_TOKEN_REQUEST_TOKEN) {\n    throw new Error(\n      'GitHub Actions OIDC is unavailable. Set id-token: [REDACTED]\n    );\n  }\n\n  const exchange = (url, token, options = {}) =>\n    request(url, {\n      ...options,\n      headers: { Accept: 'application/json', Authorization: [REDACTED] ${token}` },\n      redirect: 'error',\n      signal: globalThis.AbortSignal.timeout(15000),\n    });\n\n  const oidc = new URL(ACTIONS_ID_TOKEN_REQUEST_URL);\n  oidc.searchParams.set('audience', 'npm:registry.npmjs.org');\n  const identity = await exchange(oidc, ACTIONS_ID_TOKEN_REQUEST_TOKEN);\n  if (!identity.ok) {\n    throw new Error(\n      `GitHub Actions OIDC request returned HTTP ${identity.status}.`\n    );\n  }\n  const { value } = await identity.json();\n  if (typeof value !== 'string' || !value) {\n    throw new Error(\n      'GitHub Actions OIDC response did not contain an identity token.'\n    );\n  }\n\n  const endpoint = `${NPM_REGISTRY}/-/npm/v1/oidc/token/exchange/package/${encodeURIComponent(name)}`;\n  const authorization = await exc…int, value, { method: 'POST' });\n  if (authorization.status =[REDACTED] 404) {\n    throw new Error(\n      `npm rejected trusted publishing for ${name} (HTTP 404). An npm package owner must configure the GitHub Actions trusted publisher for ${GITHUB_REPOSITORY}, workflow release.yml, with no environment and permission to publish. Then rerun the release.`\n    );\n  }\n  if (!authorization.ok) {\n    throw new Error(\n      `npm trusted publishing authorization returned HTTP ${authorization.status} for ${name}.`\n    );\n  }\n  const { token } = await authorization.json();\n  if (typeof token !== 'string' || !token) {\n    throw new Error(\n      'npm trusted publishing response did not contain a publish token.'\n    );\n  }\n}\n\nif (\n  process.argv[1] &&\n  pathToFileURL(process.argv[1]).href === import.meta.url\n) {\n  const { name } = JSON.parse(readFileSync('package.json', 'utf8'));\n  try {\n    await checkTrustedPublisher(name);\n    console.log(\n      `npm accepted the workflow identity for ${name}. Direct publish permission is checked during upload.`\n    );\n  } catch (error) {\n    console.error(`npm preflight failed: ${error.message}`);\n    if (process.env.RELEASE_DEBUG === '1') {\n      // Only report the error kind. Request headers and token bodies must never enter logs.\n      console.error(`npm preflight error type: ${error.name}`);\n    }\n    process.exitCode = 1;\n  }\n}\n3:[![npm version](https://img.shields.io/npm/v/gh-load-issue)](https://www.npmjs.com/package/gh-load-issue)\n262:# Test the packed npm artifact through an isolated installed bin link (POSIX)\n271:published version and npm `latest` tag and repeats the executable test using\n293:The workflow publishes from `main` after the required checks pass. The npm package owner must configure a GitHub Actions trusted publisher for `link-foundation/gh-load-issue`, workflow `release.yml`, with no environment and with **Allow npm publish** enabled. The preflight checks the workflow identity and package mapping. npm checks permission to publish directly when it receives the archive.\n299:- **changeset-pr** opens a draft changeset PR. Set the repository secret `RELEASE_PR_TOKEN` to a repository-scoped credential with write access to Contents and Pull requests, or add the changeset in