ait result;\n      }\n      assert.match(requests[0][0], /audience=npm%3Aregistry.npmjs.org/);\n      assert.equal(requests[1][0], 'https://registry.npmjs.org/-/npm/v1/oidc/token/exchange/package/%40scope%2Fpackage');\n      assert.equal(requests[1][1].method, 'POST');\n      assert.equal(requests[1][1].headers.Authorization, 'Bearer [REDACTED_SECRET]');\n    }\n  });\n\n  it('validates release changes with the same parser as Changesets', () => {\n    assert.equal(needsChangeset(['README.md', '.gitkeep', 'tests/test-ci-release.test.mjs']), false);\n    assert.equal(needsChangeset(['bun.lock']), true);\n    assert.equal(needsChangeset(['.github/workflows/release.yml']), true);\n    const validate = (content) => validateChangeset('gh-load-issue', 'fixture.md', content);\n    assert.doesNotThrow(() => validate('---\\\\r\\\\ngh-load-issue: patch\\\\r\\\\n---\\\\r\\\\n\\\\r\\\\nA fix.\\\\r\\\\n'));\n    assert.throws(() => validate('---\\\\nother: patch\\\\n---\\\\nA fix.\\\\n'), /must declare/);\n    assert.throws(() => validate('---\\\\ngh-load-issue: patched\\\\n---\\\\nA fix.\\\\n'), /must declare/);\n    assert.throws(() => validate('---\\\\ngh-load-issue: minor\\\\n---\\\\n'), /include a description/);\n  });\n});\n\ndescribe('GitHub release metadata', () => {\n  const manifest = { name: 'gh-load-issue', version: '1.0.0' };\n  const changelog = '# Changelog\\\\r\\\\n\\\\r\\\\n## 1.0.0\\\\r\\\\n\\\\r\\\\n### Minor Changes\\\\r\\\\n\\\\r\\\\n- Feature\\\\r\\\\n  continued\\\\r\\\\n\\\\r\\\\n### Patch Changes\\\\r\\\\n\\\\r\\\\n- Fix\\\\r\\\\n\\\\r\\\\n## 0.9.0\\\\r\\\\n\\\\r\\\\nPrevious release\\\\r\\\\n';\n  const release = { repository: 'owner/repo', commit: 'version-commit', trigger: 'trigger-commit', manifest, changelog };\n\n  it('keeps complete changelog sections together with the PR and npm badge', () => {\n    const notes = releaseNotes(changelog, manifest, 21);\n    assert.match(notes, /Feature\\\\n  continued\\\\n\\\\n### Patch Changes\\\\n\\\\n- Fix/);\n 