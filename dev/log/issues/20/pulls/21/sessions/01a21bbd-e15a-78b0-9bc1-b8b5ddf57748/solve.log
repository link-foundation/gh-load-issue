n            release=true\\n          elif [[ \\\"$EVENT_NAME\\\" == \\\"push\\\" && \\\"$GITHUB_REF\\\" == \\\"refs/heads/main\\\" ]]; then\\n            shopt -s nullglob\\n            for path in .changeset/*.md; do\\n              if [[ \\\"$path\\\" != \\\".changeset/README.md\\\" ]]; then\\n                release=true\\n                break\\n              fi\\n            done\\n          fi\\n          printf 'code=%s\\\\nrelease=%s\\\\n' \\\"$code\\\" \\\"$release\\\" >> \\\"$GITHUB_OUTPUT\\\"\\n\\n  changeset-check:\\n    name: Check for Changesets\\n    if: github.event_name == 'pull_request'\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 5\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          fetch-depth: 0\\n          persist-credentials: false\\n      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2\\n        with:\\n          bun-version: ${{ env.BUN_VERSION }}\\n      - run: bun install --frozen-lockfile --ignore-scripts\\n      - name: Validate PR changesets\\n        env:\\n          PR_BASE_SHA: ${{ github.event.pull_request.base.sha }}\\n        run: bun scripts/validate-changeset.mjs\\n\\n  lint:\\n    name: Lint and Format Check\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 5\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          persist-credentials: false\\n      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2\\n        with:\\n          bun-version: ${{ env.BUN_VERSION }}\\n      - run: bun install --frozen-lockfile --ignore-scripts\\n      - run: bun run check\\n\\n  workflows:\\n    name: Workflow validation\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 5\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          persist-credentials: false\\n      - uses: docker://rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 # v1.7.12\\n        with:\\n          args: -color\\n      - uses: zizmorcore/zizmor-action@1b4550e929643b8b26a62303c6bd64814271a4f1 # v0.9.2\\n        with:\\n          advanced-security: false\\n          version: v1.33.1\\n          strict-collection: true\\n          online-audits: false\\n\\n  release-preflight:\\n    name: Verify npm publishing authorization\\n    needs: plan\\n    if: needs.plan.outputs.release == 'true'\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 5\\n    permissions:\\n      contents: read\\n      id-token: write\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          persist-credentials: false\\n      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\\n        with:\\n          node-version: ${{ env.NODE_VERSION }}\\n          package-manager-cache: false\\n      - run: node scripts/setup-npm.mjs\\n      - run: node scripts/npm-preflight.mjs\\n\\n  test:\\n    name: Test (Bun on ${{ matrix.os }})\\n    runs-on: ${{ matrix.os }}\\n    timeout-minutes: 10\\n    needs: [plan, release-preflight]\\n    if: ${{ !cancelled() && needs.plan.outputs.code == 'true' && (needs.plan.outputs.release != 'true' || needs.release-preflight.result == 'success') }}\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        os: [ubuntu-24.04, macos-15, windows-2025]\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          persist-credentials: false\\n      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2\\n        with:\\n          bun-version: ${{ env.BUN_VERSION }}\\n      - run: bun install --frozen-lockfile --ignore-scripts\\n      - name: Run unit and GitHub integration tests\\n        env:\\n          GH_TOKEN: ${{ github.token }}\\n        run: bun test\\n\\n  package-smoke-test:\\n    name: Test installed npm package (Linux)\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 10\\n    needs: [plan, release-preflight]\\n    if: ${{ !cancelled() && needs.plan.outputs.code == 'true' && (needs.plan.outputs.release != 'true' || needs.release-preflight.result == 'success') }}\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          persist-credentials: false\\n      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\\n        with:\\n          node-version: ${{ env.NODE_VERSION }}\\n          package-manager-cache: false\\n      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2\\n        with:\\n          bun-version: ${{ env.BUN_VERSION }}\\n      - run: npm ci --ignore-scripts --no-audit --no-fund\\n      - name: Exercise Changesets before release\\n        run: |\\n          shopt -s nullglob\\n          for path in .changeset/*.md; do\\n            if [[ \\\"$path\\\" != \\\".changeset/README.md\\\" ]]; then\\n              npm run changeset:version\\n              break\\n            fi\\n          done\\n      - run: bun audit --audit-level moderate\\n      - run: bun run test:package\\n\\n  security-docs:\\n    name: Secrets and documentation\\n    runs-on: ubuntu-24.04\\n    timeout-minutes: 5\\n    steps:\\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\\n        with:\\n          persist-credentials: false\\n      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\\n        with:\\n          node-version: ${{ env.NODE_VERSION }}\\n          package-manager-cache: false\\n      - run: npm ci --ignore-scripts --no-audit --no-fund\\n      - run: npm audit --audit-level=moderate --package-lock-only\\n      - run: git ls-files -z | xargs -0 npm exec --no -- secretlint --no-glob --no-gitignore --format github\\n      - uses: lycheeverse/lychee-action@e7477775783ea5526144ba13e8