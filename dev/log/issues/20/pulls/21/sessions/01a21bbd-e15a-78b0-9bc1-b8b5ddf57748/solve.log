lar PR.\n- **recover** publishes the current version on `main` without another version bump. Use it when a version was already committed but publication did not finish. Rerunning a failed release also resumes the same version when its version commit is still at the tip of `main`.\n\nUse the workflow'\"'s **verbose** option or set \"'`RELEASE_DEBUG=1` locally to show release diagnostics. The workflow keeps that option off by default.\n\n'\"'''+s[ix:]\np.write_text(s)\nPY\ncat > scripts/check-file-size.mjs <<'EOF'\n#\"'!/usr/bin/env bun\n\nimport { execFileSync } from '\"'node:child_process';\nimport { readFileSync } from 'node:fs';\n\nconst MAX_LINES = 1100;\nconst files = new Set(\n  execFileSync('git', ['ls-files', '-z', '--cached', '--others', '--exclude-standard', '--', '*.js', '*.mjs', '*.cjs'], { encoding: 'utf8' })\n    .split('\\\\0')\n    .filter(Boolean)\n);\nconst missing = new Set(\n  execFileSync('git', ['ls-files', '-z', '--deleted'], { encoding: 'utf8' }).split('\\\\0')\n);\n\nfor (const file of files) {\n  if (missing.has(file)) {\n    continue;\n  }\n  const text = readFileSync(file, 'utf8');\n  const lines = text ? text.split('\\\\n').length - Number(text.endsWith('\\\\n')) : 0;\n  if (lines > MAX_LINES) {\n    console.error(\"'`${file} exceeds the ${MAX_LINES}-line limit (${lines} lines).`);\n    process.exitCode = 1;\n  }\n}\nif (!process.exitCode) {\n  console.log(`JavaScript files are within the ${MAX_LINES}-line limit.`);\n}\nEOF\n./node_modules/.bin/prettier --write .github/workflows/release.yml scripts/{check-file-size,npm-preflight}.mjs README.md > /tmp/gh-load-issue-final-format.log 2>&1\nbun run check > /tmp/gh-load-issue-final-check.log 2>&1\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
